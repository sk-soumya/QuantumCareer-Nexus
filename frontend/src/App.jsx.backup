// ============================================================
// STUDENT RESUME AI
// ============================================================

function StudentResumeAI() {
  const token = getToken();

  const [file, setFile] =
    useState(null);

  const [analysis, setAnalysis] =
    useState(null);

  const [cgpa, setCgpa] =
    useState("");

  const [skills, setSkills] =
    useState("");

  const [resumeText, setResumeText] =
    useState("");

  const [loading, setLoading] =
    useState(false);

  const [saving, setSaving] =
    useState(false);

  const [message, setMessage] =
    useState("");

  useEffect(() => {
    loadProfile();
  }, []);

  const loadProfile = async () => {
    if (!token) {
      return;
    }

    try {
      const response =
        await fetch(
          `${API_BASE_URL}/student-profile/me`,
          {
            headers: {
              Accept:
                "application/json",
              Authorization:
                `Bearer ${token}`,
            },
          }
        );

      if (
        response.status === 404 ||
        !response.ok
      ) {
        return;
      }

      const data =
        await response.json();

      setCgpa(
        data.cgpa !== null &&
        data.cgpa !== undefined
          ? String(data.cgpa)
          : ""
      );

      setSkills(
        data.skills || ""
      );

      setResumeText(
        data.resume_text || ""
      );
    } catch (error) {
      console.error(error);
    }
  };

  const analyzeResume = async () => {
    if (!file) {
      setMessage(
        "Please choose a PDF resume."
      );
      return;
    }

    setLoading(true);
    setMessage("");

    try {
      const formData =
        new FormData();

      formData.append(
        "file",
        file
      );

      const response =
        await fetch(
          `${API_BASE_URL}/resume/analyze`,
          {
            method: "POST",
            body: formData,
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.detail ||
            "Resume analysis failed."
        );
      }

      setAnalysis(data);

      setSkills(
        Array.isArray(data.skills)
          ? data.skills.join(", ")
          : ""
      );

      if (
        data.cgpa !== null &&
        data.cgpa !== undefined
      ) {
        setCgpa(
          String(data.cgpa)
        );
      }

      setResumeText(
        data.extracted_text || ""
      );

      setMessage(
        "Resume analyzed successfully."
      );
    } catch (error) {
      setMessage(
        error.message ||
          "Resume analysis failed."
      );
    } finally {
      setLoading(false);
    }
  };

  const saveProfile = async () => {
    setSaving(true);
    setMessage("");

    try {
      const cgpaValue =
        cgpa.trim() === ""
          ? null
          : Number(cgpa);

      if (
        cgpaValue !== null &&
        (
          Number.isNaN(cgpaValue) ||
          cgpaValue < 0 ||
          cgpaValue > 10
        )
      ) {
        throw new Error(
          "CGPA must be between 0 and 10."
        );
      }

      const response =
        await fetch(
          `${API_BASE_URL}/student-profile/me`,
          {
            method: "PUT",
            headers: {
              "Content-Type":
                "application/json",
              Accept:
                "application/json",
              Authorization:
                `Bearer ${token}`,
            },
            body: JSON.stringify({
              cgpa: cgpaValue,
              skills,
              resume_text:
                resumeText,
            }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.detail ||
            "Profile save failed."
        );
      }

      setMessage(
        "Profile saved successfully."
      );

      setCgpa(
        data.cgpa !== null &&
        data.cgpa !== undefined
          ? String(data.cgpa)
          : ""
      );

      setSkills(
        data.skills || ""
      );

      setResumeText(
        data.resume_text || ""
      );
    } catch (error) {
      setMessage(
        error.message ||
          "Profile save failed."
      );
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="dashboard-page">
      <DashboardHeader
        title="Resume AI"
        role="STUDENT"
      />

      <div className="dashboard-body">
        <Sidebar
          items={getNavigation("STUDENT")}
        />

        <main className="page-content">

          <div className="page-card">
            <h2>Resume AI</h2>

            <p>
              Upload and analyze your resume.
            </p>

            <input
              type="file"
              accept=".pdf,application/pdf"
              onChange={(event) =>
                setFile(
                  event.target.files?.[0] ||
                    null
                )
              }
            />

            <button
              type="button"
              className="primary-btn"
              onClick={analyzeResume}
              disabled={loading}
            >
              {loading
                ? "Analyzing..."
                : "Analyze Resume"}
            </button>

            {file && (
              <p>
                Selected:{" "}
                <strong>
                  {file.name}
                </strong>
              </p>
            )}

            {message && (
              <p>{message}</p>
            )}

            {analysis && (
              <div className="ai-result">
                <h3>
                  Detected Skills
                </h3>

                <p>
                  {skills ||
                    "No skills detected."}
                </p>

                {analysis.cgpa !== null &&
                  analysis.cgpa !==
                    undefined && (
                    <p>
                      <strong>
                        Detected CGPA:
                      </strong>{" "}
                      {analysis.cgpa}
                    </p>
                  )}

                <h3>
                  Suggestions
                </h3>

                {analysis.suggestions?.map(
                  (
                    suggestion,
                    index
                  ) => (
                    <p key={index}>
                      ✓ {suggestion}
                    </p>
                  )
                )}
              </div>
            )}
          </div>

          <div className="page-card">
            <h2>
              Student Profile
            </h2>

            <label>
              CGPA
            </label>

            <input
              type="number"
              min="0"
              max="10"
              step="0.01"
              value={cgpa}
              onChange={(event) =>
                setCgpa(
                  event.target.value
                )
              }
              placeholder="Example: 8.2"
            />

            <label>
              Skills
            </label>

            <input
              type="text"
              value={skills}
              onChange={(event) =>
                setSkills(
                  event.target.value
                )
              }
              placeholder="Python, SQL, React"
            />

            <label>
              Resume Text
            </label>

            <textarea
              rows="12"
              value={resumeText}
              onChange={(event) =>
                setResumeText(
                  event.target.value
                )
              }
            />

            <button
              type="button"
              className="primary-btn"
              onClick={saveProfile}
              disabled={saving}
            >
              {saving
                ? "Saving..."
                : "Save Profile"}
            </button>
          </div>

        </main>
      </div>
    </div>
  );
}

// ============================================================
// LOGIN
// ============================================================

function Login() {
  const navigate =
    useNavigate();

  const [email, setEmail] =
    useState("");

  const [password, setPassword] =
    useState("");

  const [loading, setLoading] =
    useState(false);

  const [message, setMessage] =
    useState("");

  useEffect(() => {
    const token = getToken();
    const role = getRole();

    if (token && role) {
      navigate(
        getDashboardPath(role),
        {
          replace: true,
        }
      );
    }
  }, [navigate]);

  const login = async () => {
    if (
      !email.trim() ||
      !password
    ) {
      setMessage(
        "Enter email and password."
      );
      return;
    }

    setLoading(true);
    setMessage("");

    try {
      const response =
        await fetch(
          `${API_BASE_URL}/auth/login`,
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/json",
              Accept:
                "application/json",
            },
            body: JSON.stringify({
              email:
                email.trim(),
              password,
            }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.detail ||
            "Login failed."
        );
      }

      if (!data.access_token) {
        throw new Error(
          "No access token returned."
        );
      }

      localStorage.setItem(
        "campuslink_token",
        data.access_token
      );

      const payload =
        decodeToken(
          data.access_token
        );

      if (!payload?.role) {
        throw new Error(
          "Login token does not contain a role."
        );
      }

      navigate(
        getDashboardPath(
          payload.role
        ),
        {
          replace: true,
        }
      );
    } catch (error) {
      setMessage(
        error.message ||
          "Unable to login."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="login-page">
      <div className="login-card">

        <h1>CampusLink</h1>

        <p>
          Placement Management
          & AI Platform
        </p>

        <h2>Login</h2>

        <label>
          Email
        </label>

        <input
          type="email"
          value={email}
          placeholder="student2@test.com"
          onChange={(event) =>
            setEmail(
              event.target.value
            )
          }
        />

        <label>
          Password
        </label>

        <input
          type="password"
          value={password}
          placeholder="Enter password"
          onChange={(event) =>
            setPassword(
              event.target.value
            )
          }
        />

        <button
          type="button"
          className="primary-btn"
          onClick={login}
          disabled={loading}
        >
          {loading
            ? "Logging in..."
            : "Login to CampusLink"}
        </button>

        {message && (
          <p className="profile-message">
            {message}
          </p>
        )}

      </div>
    </div>
  );
}

